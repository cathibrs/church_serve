# Variáveis do site. Local: ficam em ".env.local", que não vai para o Git.
#   neon env pull        grava as quatro primeiras a partir do projeto do Neon vinculado (.neon)
# No Netlify: cadastre DATABASE_URL, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL e ALLOWED_EMAILS
# em Project configuration > Environment variables. Não cadastre lá as demais linhas do
# .env.local (NEON_BRANCH etc.): o site não usa.
#
# Os valores ficam vazios aqui de propósito: este arquivo vai para o repositório.

# Postgres do Neon, conexão "pooled" (o endereço do servidor tem -pooler). Usada pela API.
DATABASE_URL=
# Postgres do Neon, conexão direta. Usada só pela carga inicial (npm run import).
DATABASE_URL_UNPOOLED=

# Neon Auth: endereço do login e das chaves públicas. A API usa os dois; o navegador recebe
# o primeiro por /api/config.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Quem pode acessar a escala (e-mails separados por vírgula). Esta você preenche à mão.
# Conta criada com e-mail fora desta lista não vê nem altera nada.
ALLOWED_EMAILS=
