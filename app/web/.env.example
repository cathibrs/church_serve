# Variáveis do site. Local: ficam em ".env.local", que não vai para o Git.
#   neon env pull        grava as quatro primeiras a partir do projeto do Neon vinculado (.neon)
# No Netlify: cadastre DATABASE_URL, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL e ALLOWED_EMAILS
# em Site configuration > Environment variables.

# Postgres do Neon (conexão "pooled": o endereço tem -pooler). Usada pela API.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
# Conexão direta, usada só pela carga inicial (npm run import).
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth. O site (navegador) e a API usam o mesmo endereço.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Quem pode acessar a escala (e-mails separados por vírgula). Esta você preenche à mão.
# Conta criada com e-mail fora desta lista não vê nem altera nada.
ALLOWED_EMAILS=lider1@exemplo.com,lider2@exemplo.com
