# Variáveis do site. Local: ficam em ".env.local", que não vai para o Git.
#   neon env pull        grava todas a partir do projeto do Neon vinculado (.neon)
# No Netlify: cadastre DATABASE_URL e NEON_AUTH_BASE_URL em
# Project configuration > Environment variables. Não cadastre lá as demais linhas do
# .env.local (NEON_BRANCH etc.): o site não usa.
#
# Os valores ficam vazios aqui de propósito: este arquivo vai para o repositório.

# Postgres do Neon, conexão "pooled" (o endereço do servidor tem -pooler). Usada pela API.
DATABASE_URL=
# Postgres do Neon, conexão direta. Usada só pelos comandos de terminal (npm run admin).
DATABASE_URL_UNPOOLED=

# Neon Auth: endereço do login. A API usa para conferir os tokens; o navegador o recebe
# por /api/config.
NEON_AUTH_BASE_URL=
# Opcional: endereço das chaves públicas. Sem ela, a API usa NEON_AUTH_BASE_URL + /.well-known/jwks.json
NEON_AUTH_JWKS_URL=

# Quem pode entrar NÃO fica em variável: fica no banco (tabela app_users) e é gerenciado
# pela tela Acessos. O primeiro administrador se cria com: npm run admin -- pessoa@exemplo.com
