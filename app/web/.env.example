# Copie para ".env" (que não vai para o Git) e preencha. No Netlify, cadastre as mesmas
# variáveis em Site configuration > Environment variables.

# Postgres do Neon: use a conexão "pooled" (o endereço tem -pooler).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Console do Neon > Auth > Configuration).
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# O mesmo endereço de NEON_AUTH_BASE_URL; este vai para o navegador.
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# Quem pode acessar a escala (e-mails separados por vírgula). Conta criada com e-mail
# fora desta lista não vê nem altera nada.
ALLOWED_EMAILS=lider1@exemplo.com,lider2@exemplo.com
